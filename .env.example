# AZMERYHOME environment variables (spec §18.1 — all secrets via env vars).
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Public canonical site URL (used for canonical tags, sitemap, OG). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Form email delivery via Resend (https://resend.com) ---
# Create a free account, add an API key, and (for production) verify a sending domain.
RESEND_API_KEY=

# Inbox that receives lead notification emails.
LEAD_INBOX_EMAIL=meredith@azmeryhome.com

# From address for outgoing lead emails. Until your domain is verified in Resend,
# you can use the Resend test sender below. Replace with e.g.
# "AZMERYHOME <leads@azmeryhome.com>" once your domain is verified.
LEAD_FROM_EMAIL=AZMERYHOME <onboarding@resend.dev>
